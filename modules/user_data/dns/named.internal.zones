zone "dev.internal" IN {
        type primary;
        file "dev.internal.zone";       // /var/named/terraform.internal.zone
        allow-update { none; };
};

// TLD 도메인은 사용 x할거라서 아래 삭제해도 됨. 
//zone "terraform" IN {
//        type primary;
//        file "named.internal";
//        allow-update { none; };
//};

//Reverse Zone
// - 보통 서브넷 전체 대역대를 관리하기 때문에 그렇게 쓰는게 나음. 
zone "1.0.10.in-addr.arpa" IN {
        type primary;
        file "10.0.1.rev";
        allow-update { none; };
};

